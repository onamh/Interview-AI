# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Whisper Speech-to-Text Configuration
# Set to "local" for 100% FREE offline Whisper (No OpenAI API key required!)
# Set to "openai" for OpenAI Cloud Whisper API (Requires OPENAI_API_KEY)
WHISPER_BACKEND=local
WHISPER_MODEL=tiny

# Optional: Only needed if WHISPER_BACKEND is set to "openai"
OPENAI_API_KEY=
